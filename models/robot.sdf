<?xml version="1.0" ?>
<sdf version="1.9">
  <model name="two_link_robot">

    <static>false</static>

    <!-- Base -->
    <link name="base_link">
      <pose>0 0 0.05 0 0 0</pose>

      <inertial>
        <mass>1.0</mass>
        <inertia>
          <ixx>0.001</ixx>
          <iyy>0.001</iyy>
          <izz>0.001</izz>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>
      </inertial>

      <collision name="base_collision">
        <geometry>
          <cylinder>
            <radius>0.08</radius>
            <length>0.1</length>
          </cylinder>
        </geometry>
      </collision>

      <visual name="base_visual">
        <geometry>
          <cylinder>
            <radius>0.08</radius>
            <length>0.1</length>
          </cylinder>
        </geometry>
      </visual>
    </link>

    <!-- Link 1 -->
    <link name="link1">
      <pose>0.15 0 0.05 0 0 0</pose>

      <inertial>
        <mass>0.5</mass>
        <inertia>
          <ixx>0.001</ixx>
          <iyy>0.001</iyy>
          <izz>0.001</izz>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>
      </inertial>

      <collision name="link1_collision">
        <geometry>
          <box>
            <size>0.30 0.05 0.05</size>
          </box>
        </geometry>
      </collision>

      <visual name="link1_visual">
        <geometry>
          <box>
            <size>0.30 0.05 0.05</size>
          </box>
        </geometry>
      </visual>
    </link>

    <!-- Link 2 -->
    <link name="link2">
      <pose>0.40 0 0.05 0 0 0</pose>

      <inertial>
        <mass>0.3</mass>
        <inertia>
          <ixx>0.001</ixx>
          <iyy>0.001</iyy>
          <izz>0.001</izz>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>
      </inertial>

      <collision name="link2_collision">
        <geometry>
          <box>
            <size>0.20 0.05 0.05</size>
          </box>
        </geometry>
      </collision>

      <visual name="link2_visual">
        <geometry>
          <box>
            <size>0.20 0.05 0.05</size>
          </box>
        </geometry>
      </visual>
    </link>

    <!-- Joint 1 -->
    <joint name="joint1" type="revolute">
      <parent>base_link</parent>
      <child>link1</child>

      <pose>0 0 0.05 0 0 0</pose>

      <axis>
        <xyz>0 0 1</xyz>
        <limit>
          <lower>-3.14</lower>
          <upper>3.14</upper>
        </limit>
      </axis>
    </joint>

    <!-- Joint 2 -->
    <joint name="joint2" type="revolute">
      <parent>link1</parent>
      <child>link2</child>

      <pose>0.30 0 0 0 0 0</pose>

      <axis>
        <xyz>0 0 1</xyz>
        <limit>
          <lower>-3.14</lower>
          <upper>3.14</upper>
        </limit>
      </axis>
    </joint>

  </model>
</sdf>
